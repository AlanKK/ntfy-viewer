{
  "name": "ntfy-viewer",
  "version": "1.0.0",
  "description": "Receive ntfy notifications in your browser, even when no ntfy page is open.",
  "main": "index.js",
  "scripts": {
    "start": "npm run start:chrome",
    "start:chrome": "TARGET_BROWSER=chrome webpack --config webpack/webpack.dev.js --watch",
    "start:firefox": "TARGET_BROWSER=firefox webpack --config webpack/webpack.dev.js --watch",
    "build": "npm run build:chrome && npm run build:firefox",
    "build:chrome": "cross-env TARGET_BROWSER=chrome webpack --config webpack/webpack.prod.js && web-ext build --source-dir ./dist/chrome --artifacts-dir dist --filename ntfy-viewer-chrome.zip",
    "build:firefox": "cross-env TARGET_BROWSER=firefox webpack --config webpack/webpack.prod.js && web-ext build --source-dir ./dist/firefox --artifacts-dir dist --filename ntfy-viewer-firefox.zip",
    "clean": "rimraf dist",
    "test": "jest",
    "style": "prettier --write \"src/**/*.{ts,tsx}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "author": "Johan van Eck",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/johman10/ntfy-browser.git"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/chrome": "^0.3.7",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/webextension-polyfill": "^0.12.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.4",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "typescript": "~6.0.3",
    "web-ext": "^10.8.0",
    "webextension-polyfill": "^0.12.0",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1",
    "webpack-merge": "^6.0.1",
    "wext-manifest-loader": "^3.0.2",
    "wext-manifest-webpack-plugin": "^1.4.1"
  },
  "overrides": {
    "minimatch@>=7 <11.0.1": "^11.0.5",
    "glob@>=9 <14.0.2": "^14.0.4"
  }
}
